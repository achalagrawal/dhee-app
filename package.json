{
  "name": "dhee-app",
  "version": "0.0.1",
  "private": true,
  "description": "AI companion for questions about life, grounded in Madhyasth Darshan and spoken in plain language.",
  "license": "MIT",
  "author": "Achal Agrawal <achalxyz@gmail.com>",
  "homepage": "https://dhee.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achalagrawal/dhee-app.git"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "preview:env": "node scripts/preview-env.mjs",
    "build:legal": "node scripts/build-legal.mjs",
    "build:web": "pnpm build:legal && expo export -p web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "convex run dev:smokeTest '{}' && convex run devEmail:sesCheck '{}'",
    "eval": "node scripts/eval.mjs",
    "eval:report": "node scripts/eval-report.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.25",
    "@convex-dev/agent": "^0.6.4",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/workflow": "^0.4.4",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "ai": "^6.0.232",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.25",
    "convex": "^1.42.3",
    "expo": "^57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.3",
    "expo-network": "~57.0.1",
    "expo-router": "^57.0.7",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.0",
    "convex-test": "^0.0.54",
    "marked": "^18.0.7",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider": "3.0.14",
      "@ai-sdk/provider-utils": "4.0.40"
    }
  }
}
