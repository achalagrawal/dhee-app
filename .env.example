# Convex deployment URLs — auto-filled by `pnpm convex:dev` on first run.
# The site URL is where Better Auth's handler is mounted; the auth client talks
# to it directly (src/lib/auth-client.ts).
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=

# Everything below is set in the Convex deployment, not in this file:
#   npx convex env set NAME value
#
# Models (via OpenRouter)
#   OPENROUTER_API_KEY      Key from https://openrouter.ai/keys
#
# Sign-in email (SES v2 HTTP API — ordinary IAM keys with ses:SendEmail, *not*
# SES SMTP credentials, which cannot sign SigV4). Optional on a local backend:
# unset, the send is skipped and the OTP appears in the `convex dev` logs.
#   AWS_REGION              SES region, e.g. ap-south-1
#   AWS_ACCESS_KEY_ID       IAM key id
#   AWS_SECRET_ACCESS_KEY   Matching secret
#   AWS_SESSION_TOKEN       Only if using temporary credentials
#   AUTH_EMAIL_FROM         Sender, must be an identity verified in SES
#
# Auth
#   BETTER_AUTH_SECRET      Random secret; `openssl rand -base64 32`
#   SITE_URL                Base URL for auth links, and the web redirect allowlist
#   AUTH_GOOGLE_ID          Google OAuth client id ("Continue with Google")
#   AUTH_GOOGLE_SECRET      Google OAuth client secret
#
# Retrieval
#   MD_MCP_URL              Optional; defaults to the hosted MD MCP server
